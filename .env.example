# Copy to .env and supply your OpenAI Platform API key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Server-side Supabase credentials. Do not expose SUPABASE_SERVICE_ROLE_KEY to Vite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins permitted to call the API in production.
# Example: CORS_ORIGINS=https://worktwin-demo.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
